---
import Pupil from "./Pupil.astro";

// Illustration (données simulées) : l’extra de Limitless dans la barre des menus, agrandi.
// u : usage affiché au départ (%) ; rate : vitesse de consommation de la simulation (src/scripts/main.ts §10)
const accounts = [
  { key: "claude", letter: "C", u: 46, rate: 0.9 },
  { key: "codex", letter: "X", u: 22, rate: 0.35 },
  { key: "gemini", letter: "G", u: 71, rate: 0.5 },
] as const;
---

<div
  class="lt-menubar"
  data-fade
  role="img"
  aria-label="Illustration de Limitless dans la barre des menus : un anneau et un pourcentage par compte, Claude 46 %, Codex 22 %, Gemini 71 %."
>
  <div class="lt-strip" aria-hidden="true">
    <Pupil class="lt-mark" fill="currentColor" />
    {accounts.map((a) => (
      <span class:list={["lt-item", a.key]} data-u={a.u} data-rate={a.rate}>
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <circle class="lt-track" cx="20" cy="20" r="16" />
          <circle
            class="lt-ring"
            cx="20"
            cy="20"
            r="16"
            pathLength="100"
            transform="rotate(-90 20 20)"
            style={`stroke-dashoffset:${100 - a.u}`}
          />
          <text x="20" y="20">
            {a.letter}
          </text>
        </svg>
        <span class="lt-val">{a.u}&#8239;%</span>
      </span>
    ))}
  </div>
  <p class="lt-cap" aria-hidden="true">
    Un anneau et une valeur par compte, aux couleurs de Claude, Codex et Gemini.
  </p>
</div>
